{
    "name": "hgabka/doctrine-translatable",
    "type": "library",
    "description": "Translatable behaviour extension for Doctrine2",
    "keywords": [
        "doctrine2",
        "extensions",
        "translatable",
        "i18n"
    ],
    "homepage": "http://hgabka.eu",
    "authors": [
        {
            "name": "Gabe"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/logger-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/node-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/media-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/settings-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/utils-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/seo-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/doctrine-translatable-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/email-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/simple-content-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/i18n-routing-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/acl-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/security-acl.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/pagepart-bundle.git"
        }
    ],
    "require": {
        "php": ">=8.0.3",
        "doctrine/collections": "^2.0",
        "doctrine/common": "^3.0",
        "doctrine/inflector": "^2.0",
        "doctrine/persistence": "^4.0",
        "jms/metadata": "^1.1|^2.0"
    },
    "require-dev": {
        "doctrine/orm": "^3.0",
        "hgabka/acl-bundle": "^7.1|^8.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "symfony/security-acl": "^7.1|^8.0",
        "symfony/yaml": "^6.0"
    },
    "autoload": {
        "psr-0": {
            "Hgabka\\Doctrine\\Translatable": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hgabka\\Doctrine\\Translatable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev",
            "dev-v8": "8.0.x-dev"
        }
    }
}
